# Environment pin for binkeeper-label-drift.service; install as
# /etc/binkeeper/binkeeper-label-drift.env (no secrets belong here).
#
# Explicit ADR 0006 local-only rollback (BINK-57). The subscription-only routing
# rule forbids the former Opus/OpenRouter leg. No automatic cloud fallback.
BINKEEPER_BIN_LABEL_DRIFT_MODE=local
BINKEEPER_BIN_LABEL_DRIFT_LOCAL_TIMEOUT_S=240
# BINKEEPER_WRITES_ENABLED is deliberately inherited. Freezing the sole writer
# must freeze the nightly proposal writer too.
