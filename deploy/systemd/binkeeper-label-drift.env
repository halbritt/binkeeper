# Environment pin for binkeeper-label-drift.service; install as
# /etc/binkeeper/binkeeper-label-drift.env (no secrets belong here).
#
# ADR 0006 authorizes this nightly two-model lane to export only the bounded
# inference JPEG and prompt through OpenRouter to Anthropic. The key remains in
# /etc/binkeeper/binkeeper.env. Set mode=local to end this new export while
# retaining the durable queue and all previously recorded evidence.
BINKEEPER_BIN_LABEL_DRIFT_MODE=ensemble
BINKEEPER_BIN_LABEL_DRIFT_CLOUD_ENDPOINT=https://openrouter.ai/api/v1
BINKEEPER_BIN_LABEL_DRIFT_CLOUD_MODEL=anthropic/claude-opus-5
BINKEEPER_BIN_LABEL_DRIFT_CLOUD_TIMEOUT_S=120
BINKEEPER_BIN_LABEL_DRIFT_LOCAL_TIMEOUT_S=240
# BINKEEPER_WRITES_ENABLED is deliberately inherited. Freezing the sole writer
# must freeze the nightly proposal writer too.
