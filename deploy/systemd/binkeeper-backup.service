[Unit]
Description=Create authenticated local BinKeeper backup
ConditionPathExists=/etc/binkeeper/blob-vault.json
After=postgresql.service

[Service]
Type=oneshot
User=halbritt
Group=halbritt
EnvironmentFile=/etc/binkeeper/binkeeper.env
ExecStart=/opt/binkeeper/venv/bin/binkeeper-backup create
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/binkeeper/backups
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=binkeeper-backup
