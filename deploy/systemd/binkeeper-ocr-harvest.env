# Environment pin for binkeeper-ocr-harvest.service; install as
# /etc/binkeeper/binkeeper-ocr-harvest.env (no secrets belong here).
#
# The nightly peripheral-OCR true-up runs the free local model only: the lane
# exports nothing off-box, so it must not inherit the interactive default's
# cloud provider (ADR 0005). The unit lists this file after binkeeper.env, so
# every value here overrides the service environment.
BINKEEPER_BIN_VISION_PROVIDER=local
# Geofence anchors live at the owner-local canonical path (binkeeper.bin_geo);
# without this the harvester's default resolves inside the installed package
# and the lane exits 3 (no site configured). Precise coordinates: never in git.
BINKEEPER_BIN_SITES_FILE=/home/halbritt/.config/binkeeper/sites.json
BINKEEPER_BIN_VISION_ENDPOINT=http://peecee:11434/v1
BINKEEPER_BIN_VISION_MODEL=qwen3-vl:32b
# Local 32B inference runs ~20-95 s per photo plus ~1 min cold model load.
BINKEEPER_BIN_VISION_TIMEOUT_S=240
# The nightly pass covers the whole vault regardless of any interactive cap.
BINKEEPER_BIN_OCR_MAX_PHOTOS=0
# BINKEEPER_WRITES_ENABLED is deliberately NOT pinned: writer authority is an
# owner decision inherited from binkeeper.env; a frozen writer must also
# freeze this lane.
