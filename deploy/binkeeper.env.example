BINKEEPER_DATABASE_URL=postgresql:///binkeeper
BINKEEPER_BLOB_VAULT_CONFIG=/etc/binkeeper/blob-vault.json
BINKEEPER_HOST=127.0.0.1
BINKEEPER_PORT=8766
BINKEEPER_WRITES_ENABLED=0
BINKEEPER_BACKUP_ROOT=/var/lib/binkeeper/backups
BINKEEPER_BACKUP_MAX_AGE_SECONDS=90000
BINKEEPER_BACKUP_COMMAND_TIMEOUT_SECONDS=3600
BINKEEPER_ADMIN_DATABASE_URL=postgresql:///postgres
BINKEEPER_BIN_LABEL_CUPS_QUEUE=
BINKEEPER_BIN_LABEL_SIZE=4x6
BINKEEPER_BIN_LABEL_GAP_IN=0
BINKEEPER_BIN_LABEL_PRINT_TIMEOUT_S=15
