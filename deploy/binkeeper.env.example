BINKEEPER_DATABASE_URL=postgresql:///binkeeper
BINKEEPER_BLOB_VAULT_CONFIG=/etc/binkeeper/blob-vault.json
BINKEEPER_HOST=127.0.0.1
BINKEEPER_PORT=8766
BINKEEPER_WRITES_ENABLED=0
BINKEEPER_BACKUP_ROOT=/var/lib/binkeeper/backups
BINKEEPER_BACKUP_MAX_AGE_SECONDS=90000
BINKEEPER_BACKUP_COMMAND_TIMEOUT_SECONDS=3600
BINKEEPER_ADMIN_DATABASE_URL=postgresql:///postgres
# ADR 0004/0005: advisory-vision backend. "openrouter" (default, benchmarked)
# and "gemini" export the downscaled inference JPEG + prompt text to that
# provider; "local" keeps vision on-box.
BINKEEPER_BIN_VISION_PROVIDER=openrouter
BINKEEPER_OPENROUTER_API_KEY=
BINKEEPER_BIN_VISION_OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
# ADR 0006's separate nightly pin selects its mode/model/timeouts. This shared
# file supplies the already-authorized OpenRouter key and writer gate.
BINKEEPER_GEMINI_API_KEY=
BINKEEPER_BIN_VISION_GEMINI_MODEL=gemini-3.6-flash
BINKEEPER_BIN_LABEL_CUPS_QUEUE=
BINKEEPER_BIN_LABEL_SIZE=4x6
BINKEEPER_BIN_LABEL_GAP_IN=0
BINKEEPER_BIN_LABEL_PRINT_TIMEOUT_S=15
